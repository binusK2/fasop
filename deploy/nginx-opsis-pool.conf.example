# Tambahan untuk server block nginx FASOP yang SUDAH ADA
# (/etc/nginx/sites-available/fasop) — bukan file server block baru.
# Lihat deploy/OPSIS_WORKER_ISOLATION.md untuk urutan pemasangan yang aman
# (tanpa downtime).
#
# Prefix /opsis/ adalah SATU-SATUNYA rute yang query MSSQL langsung per
# request (sudah diverifikasi — semua app lain baca dari PostgreSQL yang
# disinkronkan cron). Jadi cukup satu location block ini; tidak perlu
# menambah pengecualian lain.
#
# Contoh di bawah sudah dicocokkan dengan gaya server block FASOP yang
# sebenarnya (proxy_set_header/timeout/buffering sama persis dengan
# location / yang sudah ada) — hanya proxy_pass yang beda target (port
# 8002, pool OPSIS, bukan 8000 pool utama).

# Tambahkan location block ini DI DALAM server { ... } yang sudah ada,
# di atas location `/` yang sudah ada — nginx sendiri sebenarnya memilih
# prefix TERPANJANG yang cocok (bukan berdasar urutan deklarasi), tapi
# taruh di atas supaya mudah dibaca berdampingan dengan location / :
location /opsis/ {
    proxy_pass http://127.0.0.1:8002;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    60s;

    proxy_buffering    on;
    proxy_buffer_size  8k;
    proxy_buffers      8 16k;
}

# Static/media tetap dilayani seperti biasa (lewat location /static/ dan
# /media/ yang sudah ada di server block existing) — tidak perlu
# diduplikasi, karena kedua pool gunicorn berasal dari STATIC_ROOT/
# MEDIA_ROOT yang sama persis (satu codebase, satu venv, hanya beda
# proses) dan nginx sudah melayani static/media langsung dari disk,
# tidak lewat gunicorn sama sekali.
