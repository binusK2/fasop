[Unit]
# Pool gunicorn KEDUA, terpisah dari service utama (gunicorn.service) —
# khusus menangani /opsis/* (satu-satunya rute yang query MSSQL langsung
# per-request; lihat deploy/OPSIS_WORKER_ISOLATION.md). Kalau MSSQL macet,
# yang kehabisan worker cuma pool ini — pool utama (dashboard, inspeksi,
# device-mon, dst, di gunicorn.service) tetap responsif.
Description=Gunicorn FASOP - OPSIS pool (isolated, gthread workers untuk polling MSSQL)
After=network.target

[Service]
# Disamakan persis dengan gunicorn.service yang sudah aktif di server ini.
User=root
Group=www-data
WorkingDirectory=/home/fasop/fasop
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/fasop/fasop/venv/bin"
Environment="LOKY_MAX_CPU_COUNT=4"
EnvironmentFile=/home/fasop/fasop/.env

# worker-class gthread: beberapa proses kecil, tiap proses banyak thread —
# cocok untuk request yang mayoritas menunggu I/O (MSSQL), bukan CPU-bound.
# Circuit breaker di opsis/mssql.py (lihat fix "circuit-break MSSQL connect
# attempts") membuat thread yang gagal connect tidak nyangkut lama, jadi
# --timeout di bawah cukup jadi jaring pengaman terakhir, bukan andalan utama.
# --timeout/--graceful-timeout/--max-requests* disamakan dengan pool utama.
#
# Bind ke TCP loopback (127.0.0.1), BUKAN unix socket — sengaja, supaya
# tidak ada masalah permission/ownership socket (User=root, Group=www-data
# di sini). Port 8002 dipilih karena pool utama sudah pakai 8000 — cek dulu
# belum bentrok: `ss -tlnp | grep 8002`.
ExecStart=/home/fasop/fasop/venv/bin/gunicorn \
    --workers 2 \
    --worker-class gthread \
    --threads 8 \
    --timeout 120 \
    --graceful-timeout 60 \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --bind 127.0.0.1:8002 \
    fasop.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
