{
  "name": "FASOP Logsheet -> Arsip NAS (harian 00:05)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 0 * * *"
            }
          ]
        }
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Tiap hari 00:05",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://__FASOP_DOMAIN__/api/v1/logsheet/export/?tanggal={{ $today.minus({ days: 1 }).toFormat('yyyy-LL-dd') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "__API_KEY__"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Unduh .xlsx (kemarin)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/mnt/nas/logsheet/LOGSHEET_MKS_{{ $today.minus({ days: 1 }).toFormat('yyyyLLdd') }}.xlsx",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "Simpan ke folder NAS",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        680,
        300
      ]
    }
  ],
  "connections": {
    "Tiap hari 00:05": {
      "main": [
        [
          {
            "node": "Unduh .xlsx (kemarin)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unduh .xlsx (kemarin)": {
      "main": [
        [
          {
            "node": "Simpan ke folder NAS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
