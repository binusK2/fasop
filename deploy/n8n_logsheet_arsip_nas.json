{
  "name": "FASOP Logsheet -> Arsip NAS (harian 00:05)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 0 * * *"
            }
          ]
        }
      },
      "id": "a1000000-0000-0000-0000-000000000001",
      "name": "Tiap hari 00:05",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Hitung tanggal KEMARIN + folder bulan (nama Indonesia) + path lengkap.\n// Pakai $today (zona instance n8n) — set GENERIC_TIMEZONE=Asia/Makassar\n// agar rollover tengah malam WITA tepat.\nconst BULAN = ['JANUARI','FEBRUARI','MARET','APRIL','MEI','JUNI','JULI',\n               'AGUSTUS','SEPTEMBER','OKTOBER','NOVEMBER','DESEMBER'];\nconst NAS_ROOT = '/mnt/nas/logsheet';\nconst d = $today.minus({ days: 1 });\nconst folder = `${NAS_ROOT}/${BULAN[d.month - 1]} ${d.year}`;\nreturn [{ json: {\n  tanggal: d.toFormat('yyyy-LL-dd'),\n  folder,\n  path: `${folder}/LOGSHEET_MKS_${d.toFormat('yyyyLLdd')}.xlsx`,\n} }];\n"
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "Hitung path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://__FASOP_DOMAIN__/api/v1/logsheet/export/?tanggal={{ $('Hitung path').item.json.tanggal }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "__API_KEY__"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "Unduh .xlsx (kemarin)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Hitung path').item.json.path }}",
        "dataPropertyName": "data",
        "options": {
          "append": false
        }
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "Simpan ke folder NAS",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "connections": {
    "Tiap hari 00:05": {
      "main": [
        [
          {
            "node": "Hitung path",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hitung path": {
      "main": [
        [
          {
            "node": "Unduh .xlsx (kemarin)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Unduh .xlsx (kemarin)": {
      "main": [
        [
          {
            "node": "Simpan ke folder NAS",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
